{
  "name": "html-report",
  "version": "0.1.0",
  "description": "Generated HTML reporting for vacuum",
  "main": "index.js",
  "repository": "https://github.com/daveshanley/vacuum",
  "author": "Dave Shanley",
  "license": "MIT",
  "scripts": {
    "start": "webpack --mode=development --watch",
    "build": "webpack --mode=production",
    "lint": "eslint src/ && prettier \"src/**/*.ts\" --check",
    "format": "eslint src/ --fix && prettier \"src/**/*.ts\" --write",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "css-loader": "^7.1.5",
    "lit": "^3.3.3",
    "style-loader": "^4.0.0",
    "terminal.css": "^0.7.5",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
