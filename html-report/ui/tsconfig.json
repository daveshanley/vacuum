{
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "./build/dist/",
    "noImplicitAny": false,
    "module": "es6",
    "target": "es6",
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "rootDir": "./src",
    "strict": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "./build",
    "web-test-runner.config.mjs",
    "webpack.config.js",
    "**/*.test.ts"
  ]
}
